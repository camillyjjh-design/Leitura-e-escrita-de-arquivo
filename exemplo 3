import java.io.File

//Exemplo 3: Mapeamento de Terreno e Busca de Alvo (Arquivo + Matriz + continue e break)
//Demonstra como carregar um arquivo de texto em uma matriz 2D e controlar laços aninhados.
fun main() {
    val arquivoMapa = File("mapa_radar.txt")

    //Salva a grade 4x4 no arquivo (0 = vazio, 1 = vegetação, 2 = obstáculo, 9 = alvo prioritário)
    arquivoMapa.writeText(
        "0 1 0 2\n" +
            "1 0 0 1\n" +
            "0 2 9 0\n" +
            "1 1 0 2"
    )

    //Lê todas as linhas do arquivo para descobrir a dimensão da grade
    val linhasArquivo = arquivoMapa.readLines()
    val n = linhasArquivo.size

    //1. Cria a matriz n x n de inteiros e preenche com os valores convertidos do arquivo
    val matrizRadar = Array(n) { IntArray(n) }
    for (i in 0 until n) {
        val colunasTexto = linhasArquivo[i].trim().split(" ")
        for (j in 0 until n) {
            matrizRadar[i][j] = colunasTexto[j].toInt()
        }
    }

    //2. Varre a matriz usando continue para ignorar setores vazios e break para parar ao achar o alvo
    println("Iniciando varredura do radar...")
    var alvoEncontrado = false //Flag para interromper também o laço externo quando o alvo for achado

    for (i in matrizRadar.indices) {
        for (j in matrizRadar[i].indices) {
            val setor = matrizRadar[i][j]

            //Pula imediatamente para a próxima coluna se o setor estiver vazio (0)
            if (setor == 0) {
                continue
            }

            println("Analisando setor [$i][$j] -> Código: $setor")

            //Encerra o laço interno assim que o alvo prioritário (9) é localizado
            if (setor == 9) {
                println("ALVO PRIORITÁRIO LOCALIZADO na coordenada [$i][$j]!")
                alvoEncontrado = true
                break
            }
        }

        //Encerra o laço externo caso o alvo tenha sido encontrado no laço interno
        if (alvoEncontrado) {
            break
        }
    }
}
